{
  "Xor": {
    "description": "Element-wise bitwise exclusive-or of two integer operands.",
    "num_args": 2,
    "kwargs": {},
    "ast_node": "ast.BinOp",
    "ast_mapping": {
      "operand1": "node.left",
      "operand2": "node.right"
    },
    "return_dtype": "SAME_AS_OPERAND",
    "usage_example": "result = SSARegistry.emit_ssa(Handler.Xor, builder, ['a', 'b'])"
  },
  "SExt": {
    "description": "Sign-extend an integer operand to a larger bit-width.",
    "num_args": 1,
    "kwargs": {
      "bitwidth": {
        "type": "int",
        "description": "Number of bits to extend to"
      }
    },
    "ast_node": "ast.Call",
    "ast_mapping": {
      "operand": "node.args[0]",
      "bitwidth": "node.args[1]"
    },
    "return_dtype": "int(bitwidth)",
    "usage_example": "result = SSARegistry.emit_ssa(Handler.Sext, builder, ['x'], bitwidth=32)"
  },
  "Eq": {
    "description": "Element-wise compare two operands for equality, returning a boolean mask.",
    "num_args": 2,
    "kwargs": {},
    "ast_node": "ast.Compare",
    "ast_mapping": {
      "operand1": "node.left",
      "operand2": "node.comparators[0]"
    },
    "return_dtype": "bool",
    "usage_example": "result = SSARegistry.emit_ssa(Handler.Eq, builder, ['a', 'b'])"
  },
  "Neg": {
    "description": "Arithmetic negation of a single operand.",
    "num_args": 1,
    "kwargs": {},
    "ast_node": "ast.UnaryOp",
    "ast_mapping": {
      "operand": "node.operand"
    },
    "return_dtype": "SAME_AS_OPERAND",
    "usage_example": "result = SSARegistry.emit_ssa(Handler.Neg, builder, ['x'])"
  },
  "Load": {
    "description": "Load a value from memory at a given address, optionally with alignment and volatility flags.",
    "num_args": 1,
    "kwargs": {
      "alignment": {
        "type": "int",
        "description": "Byte alignment requirement for the load"
      },
      "volatile": {
        "type": "bool",
        "description": "Whether this is a volatile memory access"
      }
    },
    "ast_node": "ast.Subscript",
    "ast_mapping": {
      "address": "node.value",
      "index": "node.slice"
    },
    "return_dtype": "SAME_AS_OPERAND_DEREFERENCED",
    "usage_example": "result = SSARegistry.emit_ssa(Handler.Load, builder, ['ptr'], alignment=8, volatile=False)"
  }
}